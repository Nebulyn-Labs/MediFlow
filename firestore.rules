rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isFacilityUser(facilityId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'facility_head' &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.facilityId == facilityId)
        ||
        (exists(/databases/$(database)/documents/facilities/$(facilityId)) &&
         request.auth.token.email.lower() == get(/databases/$(database)/documents/facilities/$(facilityId)).data.email.lower())
      );
    }

    // Deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Facilities collection
    match /facilities/{facilityId} {
      allow get: if isAdmin() || (isAuthenticated() && (resource == null || request.auth.token.email.lower() == resource.data.email.lower()));
      allow list: if isAdmin();
      
      allow create: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == request.resource.data.email.lower());
      allow update: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == resource.data.email.lower() && request.auth.token.email.lower() == request.resource.data.email.lower());
      allow delete: if false; // Admin deletions must go through backend audit Callable Function
    }

    // Inventory collection
    match /inventory/{facilityId} {
      allow read, create, update: if isAdmin() || isFacilityUser(facilityId);
      allow delete: if isAdmin();

      match /medicines/{medicineId} {
        allow read, create, update: if isAdmin() || isFacilityUser(facilityId);
        allow delete: if isAdmin();
      }
    }

    // Collection Group rule for medicines
    match /{path=**}/medicines/{medicineId} {
      allow read: if isAdmin();
    }

    // Daily Usage Logs collection
    match /daily_usage_logs/{facilityId} {
      allow read, create, update: if isAdmin() || isFacilityUser(facilityId);
      allow delete: if isAdmin();

      match /logs/{logId} {
        allow read, create, update: if isAdmin() || isFacilityUser(facilityId);
        allow delete: if isAdmin();
      }
    }

    // Requests collection
    match /requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && isFacilityUser(resource.data.facilityId));
      allow create: if isAdmin() || (isAuthenticated() && request.resource.data.facilityId != null && isFacilityUser(request.resource.data.facilityId));
      // Facility users may update their own requests but cannot escalate status to approved/fulfilled;
      // only admins are permitted to approve or fulfil a request.
      allow update: if isAdmin() ||
        (isAuthenticated()
         && isFacilityUser(resource.data.facilityId)
         && request.resource.data.facilityId == resource.data.facilityId
         && !(request.resource.data.status in ['approved', 'fulfilled']));
      allow delete: if (isAuthenticated() && isFacilityUser(resource.data.facilityId)); // Admin deletions must go through backend audit Callable Function
    }

    // Audit Logs collection
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Alerts collection
    match /alerts/{alertId} {
      allow read: if isAdmin() || (isAuthenticated() && resource != null && isFacilityUser(resource.data.facilityId));
      allow write: if isAdmin();
    }

    // Notifications collection
    match /notifications/{facilityId} {
      allow read: if isAdmin() || isFacilityUser(facilityId);
      
      match /items/{notificationId} {
        allow read: if isAdmin() || isFacilityUser(facilityId);
        allow update: if isFacilityUser(facilityId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow write: if isAdmin();
      }
    }

    // Users collection (RBAC)
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      // Self-registration is allowed only when the facilityId the user claims is provably
      // owned by them: the facility document's email must match the caller's verified Auth email.
      allow create: if isAdmin() ||
        (isAuthenticated()
         && request.auth.uid == userId
         && request.resource.data.role == 'facility_head'
         && request.resource.data.facilityId != null
         && exists(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId))
         && get(/databases/$(database)/documents/facilities/$(request.resource.data.facilityId)).data.email.lower()
            == request.auth.token.email.lower());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Rate limits collection
    match /rate_limits/{rateLimitId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
