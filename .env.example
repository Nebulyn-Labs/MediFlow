# This project does not load configuration from a .env file.
#
# Firebase client configuration is already included in
# lib/firebase_options.dart.
#
# For Flutter Web, provide the reCAPTCHA site key when running or building:
# flutter run -d chrome --dart-define=RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
#
# Backend Cloud Functions use Firebase Secrets instead of a .env file.
# Configure the Gemini API key with:
# firebase functions:secrets:set GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
#
# After setting the secret, deploy the Cloud Functions:
# firebase deploy --only functions